# ============================================================================
# SOOYA configuration example
# Copy to .env and fill in. NEVER commit the real .env — it holds API keys.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# ------------------------------------------------------- container runtime --
# Only used by docker-compose. Docker creates missing bind-mount directories as
# root, which the unprivileged container user cannot write to. Set these to your
# own account so ./data and ./config stay writable:
#   echo "SOOYA_UID=$(id -u)" >> .env
#   echo "SOOYA_GID=$(id -g)" >> .env
SOOYA_UID=1001
SOOYA_GID=1001

# ---------------------------------------------------------------- runtime --
NODE_ENV=production
HOST=0.0.0.0
PORT=8788
LOG_LEVEL=info

# Persistent data. Everything the user owns lives here; upgrades never touch it.
DATA_DIR=./data
CONFIG_DIR=./config

# ----------------------------------------------------------------- access --
# Leave WEB_CHAT_TOKEN empty for a private LAN/localhost deployment.
# Set it to a long random string when the server is reachable from the internet.
#   openssl rand -hex 32
WEB_CHAT_TOKEN=
# Required for the admin API. When empty, ALL admin endpoints return 503.
ADMIN_API_TOKEN=

# ------------------------------------------------------------------ limits --
MAX_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=9
MAX_REMOTE_FETCH_BYTES=15728640
REMOTE_FETCH_TIMEOUT_MS=20000
# Only enable for a model server on the same host / private network.
ALLOW_PRIVATE_NETWORK_FETCH=false

# ----------------------------------------------------------------- backups --
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=7
BACKUP_ON_START=false

# ----------------------------------------------------------------- context --
CONTEXT_RECENT_MESSAGES=24
CONTEXT_MEMORY_LIMIT=8
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_CHUNK_MESSAGES=30
ENABLE_BACKGROUND_JOBS=true
DISABLE_MEMORY_PIPELINE=false

# ============================================================================
# Model configuration
#
# Everything below is optional: SOOYA starts with no models configured and
# reports each capability as unavailable instead of crashing.
#
# These variables OVERRIDE config/models.json, which is the fuller way to
# configure providers (timeouts, context window, vision flags, ...).
# ============================================================================

# -------------------------------------------------------------------- chat --
# provider: openai-chat | openai-responses | anthropic-messages | openai-compatible
SOOYA_CHAT_PROVIDER=openai-chat
SOOYA_CHAT_BASE_URL=https://api.openai.com/v1
SOOYA_CHAT_MODEL=gpt-4o-mini
SOOYA_CHAT_API_KEY=

# Shared fallback key used by any capability without its own key.
OPENAI_API_KEY=

# -------------------------------------------------------- optional extras --
# Long-term memory recall. Without it SOOYA falls back to full-text search.
SOOYA_EMBEDDING_BASE_URL=https://api.openai.com/v1
SOOYA_EMBEDDING_MODEL=
SOOYA_EMBEDDING_API_KEY=

# Image generation. Without it SOOYA says it cannot draw, and never crashes.
SOOYA_IMAGE_BASE_URL=https://api.openai.com/v1
SOOYA_IMAGE_MODEL=
SOOYA_IMAGE_API_KEY=

# Text to speech (voice messages from SOOYA).
SOOYA_TTS_BASE_URL=https://api.openai.com/v1
SOOYA_TTS_MODEL=
SOOYA_TTS_VOICE=alloy
SOOYA_TTS_API_KEY=

# Speech to text (transcribing the user's voice notes).
SOOYA_STT_BASE_URL=https://api.openai.com/v1
SOOYA_STT_MODEL=
SOOYA_STT_API_KEY=
