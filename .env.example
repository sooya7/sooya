# ============================================================================
# SOOYA configuration example
# Copy to .env and fill in. NEVER commit the real .env — it holds API keys.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# ------------------------------------------------------- container runtime --
# Only used by docker-compose. Docker creates missing bind-mount directories as
# root, which the unprivileged container user cannot write to. Set these to your
# own account so ./data and ./config stay writable:
#   echo "SOOYA_UID=$(id -u)" >> .env
#   echo "SOOYA_GID=$(id -g)" >> .env
SOOYA_UID=1001
SOOYA_GID=1001

# ---------------------------------------------------------------- runtime --
NODE_ENV=production
HOST=0.0.0.0
PORT=8788
LOG_LEVEL=info

# Persistent data. Everything the user owns lives here; upgrades never touch it.
DATA_DIR=./data
CONFIG_DIR=./config
# Private media sources are deployment-owned, not bundled in Git/releases.
# Native install uses /opt/sooya/shared/assets/stickers and /opt/sooya/shared/data/references.
# SOOYA_ASSETS_DIR=./private/stickers
# SOOYA_REFERENCES_DIR=./private/references

# ----------------------------------------------------------------- access --
# Required for the admin API. When empty, ALL admin endpoints return 503.
ADMIN_API_TOKEN=
# Comma-separated exact browser origins. Leave empty for same-origin only.
# Example: CORS_ALLOWED_ORIGINS=https://chat.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Who may set X-Forwarded-For, i.e. who is allowed to tell us the client's IP.
# req.ip drives the per-client rate limit, so this must not trust just anyone.
#   loopback (default) — Nginx on the same host, as in deploy/nginx.conf.example
#   false              — no proxy; use the socket peer address
#   <ip>,<cidr>,...    — explicit proxy addresses
# Hop counts are rejected: they allow X-Forwarded-For spoofing (GHSA-3m5p-2c4r-xxw2).
TRUST_PROXY=loopback

# ------------------------------------------------------------------ limits --
MAX_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=9
MAX_REMOTE_FETCH_BYTES=15728640
REMOTE_FETCH_TIMEOUT_MS=20000
# Only enable for a model server on the same host / private network.
ALLOW_PRIVATE_NETWORK_FETCH=false

# --------------------------------------------------------------- MCP / memory --
# The default backend is Ombre Brain. Keep the token out of git; the value is
# read from the environment named below and is never returned by diagnostics.
# For the systemd deployment this points at the loopback-only Ombre service.
# Leave empty to use shared/config/mcp.json when present, then the bundled
# release default. Set an absolute path for an operator-managed file.
MCP_CONFIG_PATH=
MCP_CONNECT_ON_START=true
MCP_READ_ENABLED=true
MCP_WRITE_ENABLED=true
MCP_MAINTENANCE_ENABLED=true
MCP_TOOL_REFRESH_INTERVAL_MS=21600000
MEMORY_BACKEND=ombre
OMBRE_MCP_URL=http://127.0.0.1:18001/mcp
OMBRE_MCP_TOKEN=
OMBRE_READ_ENABLED=true
OMBRE_WRITE_ENABLED=true
OMBRE_DREAM_ENABLED=true
OMBRE_DREAM_INTERVAL_MS=86400000
OMBRE_BREATH_IDLE_MINUTES=30
TOOL_MAX_ROUNDS=6
TOOL_MAX_CALLS_PER_ROUND=4
TOOL_CALL_TIMEOUT_MS=15000
TOOL_RESULT_MAX_BYTES=32768
TOOL_TOTAL_RESULT_MAX_BYTES=65536

# ----------------------------------------------------------------- backups --
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=7
BACKUP_ON_START=false
# How many recent durable events to keep (replay window for SSE reconnects).
EVENTS_KEEP=2000

# ----------------------------------------------------------------- context --
CONTEXT_RECENT_MESSAGES=24
CONTEXT_MEMORY_LIMIT=8
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_CHUNK_MESSAGES=30
# How long a message can be withdrawn after it is sent (ms).
WITHDRAW_WINDOW_MS=300000
ENABLE_BACKGROUND_JOBS=true
DISABLE_MEMORY_PIPELINE=false

# ----------------------------------------------------- QQ 官方 Bot 单通道 --
# QQ Bot 作为唯一聊天通道（docs/QQ-BOT-SINGLE-CHANNEL-PLAN.md）。
# Secret 只存在于服务器环境变量：不进 git、不进数据库导出、不打印日志；
# Admin 只能看到「已配置 / 未配置」。
QQ_BOT_ENABLED=false
QQ_APP_ID=
# OpenAPI 鉴权用（OAuth 换 Access Token，出站 API）。
QQ_APP_SECRET=
# 开放平台控制台 Bot Secret：webhook Ed25519 签名校验（回调地址验证与事件推送共用）。
QQ_CALLBACK_SECRET=
QQ_ENV=production
# 允许绑定的 QQ 用户 openid 白名单（逗号分隔）；空 = 不接受任何新用户。
QQ_ALLOWED_USERS=
QQ_PROACTIVE_ENABLED=true

# -------------------------------------------------------- next-stage engines --
# Future / Relationship / Timeline / Learning / adaptive routing have passed
# the repository harness and are enabled together. Set any one to false to
# disable that subsystem explicitly.
FUTURE_ENGINE_ENABLED=true
FUTURE_PROACTIVE_ENABLED=true
RELATIONSHIP_CONTEXT_ENABLED=true
TIMELINE_ENABLED=true
INTERACTION_LEARNING_ENABLED=true
ADAPTIVE_PROVIDER_ROUTING_ENABLED=true

# ============================================================================
# Model configuration
#
# Models and web search are configured in 管理后台 → 模型配置. The same
# settings are stored in CONFIG_DIR/models.json and hot-reload when that file
# is edited on the server. Legacy model/search environment variables are read
# once only when migrating an old models.json; new installations do not need
# them here.
# ============================================================================

# ------------------------------------------------------------------ upgrade --
# Core upgrade flags (interruptible replies / life v2 / voice v2).
# 可打断回复与连续消息合并（第一部分）。关闭后回到旧的单发流程。
REPLY_INTERRUPTIBLE_GENERATION=true
REPLY_INITIAL_DEBOUNCE_MS=200
REPLY_INTERRUPT_DEBOUNCE_MS=300
REPLY_PUBLISH_GRACE_MS=600
REPLY_MAX_COLLECTION_MS=4000
CHAT_REQUEST_TIMEOUT_MS=45000
CHAT_TIMEOUT_RETRIES=1
CHAT_RETRY_BASE_DELAY_MS=600

# 生活系统 v2（第二部分）：Vitals、每日主题、评分制活动、防重复、故事线。
ENABLE_LIFE_V2=true

# 独立语音表达系统（第四部分）：独立口语脚本、自然度守卫、韵律规划。
VOICE_V2_ENABLED=true
VOICE_INDEPENDENT_SCRIPT_ENABLED=true
VOICE_NATURALNESS_GUARD_ENABLED=true
VOICE_ADVANCED_DELIVERY_ENABLED=true
VOICE_AUTO_COMPLEMENT_ENABLED=true
VOICE_READ_ALOUD_ENABLED=true
VOICE_DAILY_AUTO_CAP=20
VOICE_TTS_RETRIES=0

# Fish Audio TTS（provider='fish'）。API Key 只走环境变量，不写入 models.json：
# 在管理后台把 tts 的 apiKeyEnv 设为 FISH_API_KEY，models.json 只存字段名。
# FISH_API_KEY=

# ---- World context: location + weather ----
# On by default, matching config/env.ts ("useful out of the box"). These used to
# read `false` here while the code defaulted to `true`, so deleting a line
# silently flipped behaviour; both sides now agree.
# Weather uses keyless Open-Meteo, so enabling this makes outbound calls to
# open-meteo.com. Set all three to false for a fully offline deployment.
WORLD_CONTEXT_ENABLED=true
LOCATION_MODEL_ENABLED=true
WEATHER_ENABLED=true
LIFE_ADMIN_UI_ENABLED=false
VOICE_PREFERENCES_UI_ENABLED=false
METRICS_DASHBOARD_ENABLED=false
# Weather production provider (unconfigured = no-op provider, weather=unknown)
WEATHER_PROVIDER=
WEATHER_BASE_URL=
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=5000

# Visible thoughts layer (safe public thought summaries + admin decision trace)
VISIBLE_THOUGHTS_ENABLED=false
VISIBLE_INNER_MONOLOGUE_ENABLED=false
VISIBLE_THOUGHTS_TIMEOUT_MS=8000
