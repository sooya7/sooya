# ============================================================================
# SOOYA configuration example
# Copy to .env and fill in. NEVER commit the real .env — it holds API keys.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# ------------------------------------------------------- container runtime --
# Only used by docker-compose. Docker creates missing bind-mount directories as
# root, which the unprivileged container user cannot write to. Set these to your
# own account so ./data and ./config stay writable:
#   echo "SOOYA_UID=$(id -u)" >> .env
#   echo "SOOYA_GID=$(id -g)" >> .env
SOOYA_UID=1001
SOOYA_GID=1001

# ---------------------------------------------------------------- runtime --
NODE_ENV=production
HOST=0.0.0.0
PORT=8788
LOG_LEVEL=info

# Persistent data. Everything the user owns lives here; upgrades never touch it.
DATA_DIR=./data
CONFIG_DIR=./config

# ----------------------------------------------------------------- access --
# Leave WEB_CHAT_TOKEN empty for a private LAN/localhost deployment.
# Set it to a long random string when the server is reachable from the internet.
#   openssl rand -hex 32
WEB_CHAT_TOKEN=
# Required for the admin API. When empty, ALL admin endpoints return 503.
ADMIN_API_TOKEN=
# Comma-separated exact browser origins. Leave empty for same-origin only.
# Example: CORS_ALLOWED_ORIGINS=https://chat.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------ limits --
MAX_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=9
MAX_REMOTE_FETCH_BYTES=15728640
REMOTE_FETCH_TIMEOUT_MS=20000
# Only enable for a model server on the same host / private network.
ALLOW_PRIVATE_NETWORK_FETCH=false

# ----------------------------------------------------------------- backups --
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=7
BACKUP_ON_START=false
# How many recent durable events to keep (replay window for SSE reconnects).
EVENTS_KEEP=2000

# ----------------------------------------------------------------- context --
CONTEXT_RECENT_MESSAGES=24
CONTEXT_MEMORY_LIMIT=8
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_CHUNK_MESSAGES=30
# How long a message can be withdrawn after it is sent (ms).
WITHDRAW_WINDOW_MS=300000
ENABLE_BACKGROUND_JOBS=true
DISABLE_MEMORY_PIPELINE=false

# ============================================================================
# Model configuration
#
# Models and web search are configured in 管理后台 → 模型配置. The same
# settings are stored in CONFIG_DIR/models.json and hot-reload when that file
# is edited on the server. Legacy model/search environment variables are read
# once only when migrating an old models.json; new installations do not need
# them here.
# ============================================================================

# ------------------------------------------------------------------ upgrade --
# Core upgrade flags (interruptible replies / life v2 / voice v2).
# 可打断回复与连续消息合并（第一部分）。关闭后回到旧的单发流程。
REPLY_INTERRUPTIBLE_GENERATION=true
REPLY_INITIAL_DEBOUNCE_MS=200
REPLY_INTERRUPT_DEBOUNCE_MS=300
REPLY_PUBLISH_GRACE_MS=600
REPLY_MAX_COLLECTION_MS=4000
CHAT_REQUEST_TIMEOUT_MS=45000
CHAT_TIMEOUT_RETRIES=1
CHAT_RETRY_BASE_DELAY_MS=600

# 生活系统 v2（第二部分）：Vitals、每日主题、评分制活动、防重复、故事线。
ENABLE_LIFE_V2=true

# 独立语音表达系统（第四部分）：独立口语脚本、自然度守卫、韵律规划。
VOICE_V2_ENABLED=true
VOICE_INDEPENDENT_SCRIPT_ENABLED=true
VOICE_NATURALNESS_GUARD_ENABLED=true
VOICE_ADVANCED_DELIVERY_ENABLED=true
VOICE_AUTO_COMPLEMENT_ENABLED=true
VOICE_READ_ALOUD_ENABLED=true
VOICE_DAILY_AUTO_CAP=20
VOICE_TTS_RETRIES=0

# ---- Next phase: world context / admin / experiments (default OFF) ----
WORLD_CONTEXT_ENABLED=false
LOCATION_MODEL_ENABLED=false
WEATHER_ENABLED=false
LIFE_ADMIN_UI_ENABLED=false
VOICE_PREFERENCES_UI_ENABLED=false
METRICS_DASHBOARD_ENABLED=false
# Weather production provider (unconfigured = no-op provider, weather=unknown)
WEATHER_PROVIDER=
WEATHER_BASE_URL=
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=5000

# Visible thoughts layer (safe public thought summaries + admin decision trace)
VISIBLE_THOUGHTS_ENABLED=false
VISIBLE_INNER_MONOLOGUE_ENABLED=false
VISIBLE_THOUGHTS_TIMEOUT_MS=8000
