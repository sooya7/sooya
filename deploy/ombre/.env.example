# Copy to /opt/ombre-brain/.env and chmod 600. Never commit the real file.
# Required by Ombre's memory dehydration path:
OMBRE_COMPRESS_API_KEY=
OMBRE_COMPRESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OMBRE_COMPRESS_MODEL=gemini-2.5-flash-lite
OMBRE_COMPRESS_TIMEOUT_SECONDS=120

# Optional semantic indexing; leave blank to use lexical fallback.
OMBRE_EMBED_BACKEND=api
OMBRE_EMBED_API_KEY=
OMBRE_EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OMBRE_EMBED_MODEL=gemini-embedding-001
OMBRE_EMBED_TIMEOUT_SECONDS=120

# Dashboard and MCP authentication. Generate with: openssl rand -hex 32
OMBRE_DASHBOARD_PASSWORD=
OMBRE_MCP_AUTH_MODE=token
OMBRE_MCP_TOKEN=

# Keep the service local; SOOYA connects over loopback.
OMBRE_BIND_HOST=0.0.0.0

# Optional build-time PyPI mirror. Set this when the host cannot reach the
# default PyPI endpoint directly; it is not passed to the running service.
# OMBRE_PIP_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple
# OMBRE_PIP_TRUSTED_HOST=
