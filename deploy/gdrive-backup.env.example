# SOOYA Google Drive backup settings.
# Installed as /opt/sooya/shared/gdrive-backup.env by setup-gdrive-backup.sh.
# rclone OAuth credentials are NOT stored here and are not included in SOOYA backups.

GDRIVE_BACKUP_ENABLED=true
GDRIVE_RCLONE_REMOTE=gdrive
GDRIVE_BACKUP_PATH=SOOYA/backups
GDRIVE_RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Number of full tar.gz archives to keep on the server and Google Drive.
GDRIVE_LOCAL_KEEP=14
GDRIVE_REMOTE_KEEP=30

# Optional override for the local cloud-backup staging directory.
# GDRIVE_LOCAL_DIR=/opt/sooya/shared/data/backups/cloud
